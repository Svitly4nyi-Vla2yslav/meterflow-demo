{
  "name": "meterflow-demo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "npm install --prefix backend --ignore-scripts && npm install --prefix frontend --ignore-scripts && npm run prisma:generate --prefix backend && npm run build:netlify --prefix backend && npm run build --prefix frontend",
